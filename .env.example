# =========================================================
# JARVIS DUAL-DISPLAY AGENT CONFIGURATION
# =========================================================

# Google Gemini API Key (Required for the LLM brain)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# =========================================================
# DUAL-DISPLAY & WINDOW PINNING GEOMETRY
# Assumes Monitor 1 (e.g. 1920x1080) on left, Monitor 2 on right.
# Set SECOND_DISPLAY_X to where your second screen begins.
# If Monitor 2 is on the left, use negative coordinates (e.g. -1920).
# =========================================================
SECOND_DISPLAY_X=1920
SECOND_DISPLAY_Y=0

# HUD Command Center Position (Left half of Monitor 2)
HUD_WINDOW_X=1920
HUD_WINDOW_Y=0
HUD_WINDOW_WIDTH=960
HUD_WINDOW_HEIGHT=1040

# Playwright Browser Automation Window (Right half of Monitor 2)
BROWSER_WINDOW_X=2880
BROWSER_WINDOW_Y=0
BROWSER_WINDOW_WIDTH=960
BROWSER_WINDOW_HEIGHT=1040

# Persistent Chromium User Data Directory (stores logins for WhatsApp, Colab, Kaggle)
CHROME_PROFILE_DIR=~/.jarvis_chrome_profile

# =========================================================
# GOOGLE WORKSPACE OAUTH (GMAIL, CALENDAR, TASKS, DRIVE)
# Place your credentials.json in project root, then run: python setup_google_oauth.py
# =========================================================
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# =========================================================
# TELEGRAM PHONE INTERFACE (OPTIONAL)
# Create a bot via @BotFather and get your user ID via @userinfobot
# =========================================================
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# =========================================================
# KAGGLE API (OPTIONAL)
# Generated from Kaggle -> Account -> Create New API Token
# =========================================================
KAGGLE_USERNAME=
KAGGLE_KEY=

# =========================================================
# SERVER & LOCAL VOICE LISTENER
# =========================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
VOICE_LANGUAGE=en-IN
WAKE_WORD=jarvis
